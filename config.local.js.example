// Copy this file to config.local.js. That copy is gitignored.
// Put the real Device Access ids and the Hue app key only in config.local.js
// or in the tablet's Setup / Pair screens. Never commit them.
(function () {
  var cfg = window.KH_CONFIG;
  if (!cfg) {
    return;
  }
  cfg.nest = {
    projectId: '',
    clientId: '',
    clientSecret: '',
    refreshToken: '',
    pubsubProjectId: '',
    pubsubSubscription: '',
    doorbellId: '',
    thermostatId: ''
  };
  cfg.hue = {
    bridgeIp: '',
    appKey: ''
  };
  cfg.smartthings = {
    token: '',
    lockName: 'front'
  };
  // Garage entity id only. Put the Home Assistant URL and token in
  // homeassistant.json on the home server, never in this file.
  // if (cfg.doors && cfg.doors.length > 1) {
  //   cfg.doors[1].entityId = 'cover.garage_door';
  // }
})();
