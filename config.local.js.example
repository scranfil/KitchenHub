// Copy this file to config.local.js. That copy is gitignored.
// Put the real Device Access ids and the Hue app key only in config.local.js
// or in the tablet's Setup / Pair screens. Never commit them.
(function () {
  var cfg = window.KH_CONFIG;
  if (!cfg) {
    return;
  }
  cfg.nest = {
    projectId: '',
    clientId: '',
    clientSecret: '',
    refreshToken: '',
    pubsubProjectId: '',
    pubsubSubscription: '',
    doorbellId: '',
    thermostatId: ''
  };
  cfg.hue = {
    bridgeIp: '',
    appKey: ''
  };
  cfg.smartthings = {
    token: '',
    lockName: 'front'
  };
  // Door entity ids are not secrets. The Home Assistant URL and token
  // belong in homeassistant.json on the home server, never in this file.
  // The front door already defaults to lock.entryway_entryway_lock.
  // if (cfg.doors && cfg.doors[0]) {
  //   cfg.doors[0].entityId = 'lock.entryway_entryway_lock';
  // }
  // if (cfg.doors && cfg.doors[1]) {
  //   cfg.doors[1].entityId = 'cover.garage_door';
  // }
  // Thermostat status. This is the Home Assistant climate entity id, not a secret.
  cfg.climate = {
    entityId: 'climate.hallway_hallway_thermostat'
  };
})();
